
# Jarvis AI Configuration Template
# Rename this file to .env and fill in your values.

# --- Core Identity ---
ASSISTANT_NAME=Jarvis
USER_NAME=Sir

# --- API Keys ---
# Get your AccessKey from https://console.picovoice.ai/
PICOVOICE_API_KEY=YOUR_PICOVOICE_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Agentic Mode (Magic Key) ---
# Paste ANY key here: Groq (gsk_...), Gemini (AIzaSy...), or OpenRouter (sk-or-v1-...)
MASTER_AGENTIC_KEY=

# --- Device Specific ---
# Your Bluetooth MAC address for Proximity Lock (Optional)
# Format: XX-XX-XX-XX-XX-XX
PHONE_MAC_ADDRESS=

# --- Paths ---
# Path to your reference photo for FaceID (Optional)
# If empty, defaults to data/me.jpg
REFERENCE_IMAGE_PATH=data/me.jpg
# PAT-based auth (Python backend)
SMARTTHINGS_PAT=
SMARTTHINGS_DEVICE_ID=

# --- SmartThings OAuth (Swift JarvisACController Bridge) ---
# Get Client ID + Secret from https://smartthings.developer.samsung.com/
ST_CLIENT_ID=
ST_CLIENT_SECRET=
# Same device UUID as SMARTTHINGS_DEVICE_ID
ST_DEVICE_ID=ee2f1cab-7be3-3d30-895e-69af725c7291
# Initial tokens — copy from SmartThings OAuth flow.
# After first run, tokens are auto-refreshed and saved to UserDefaults.
ST_ACCESS_TOKEN=
ST_REFRESH_TOKEN=
